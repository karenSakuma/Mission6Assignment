@{
    Layout = "_Layout";
}
@model List<Movies>
<!DOCTYPE html>

<html>
<head>
    <title>Movie Database</title>
</head>
<body>
<div>
    <table class="table table-bordered">
        <thead class="fw-bold">
        <!--each of these are columns on the database-->
        <tr>
            <td>Category</td>
            <td>Title</td>
            <td>Year</td>
            <td>Director</td>
            <td>Rating</td>
            <td>Edited</td>
            <td>Lent to</td>
            <td>Copied to Plex</td>
            <td>Notes</td>
        </tr>
        </thead>
        <!--loop through the table and populate the table-->
        @foreach (var x in Model)
        {
            <tbody>
            <tr>
                <td>@x.Category.CategoryName</td> <!--show the category name-->
                <td>@x.Title</td>
                <td>@x.Year</td>
                <td>@x.Director</td>
                <td>@x.Rating</td>
                <td>@x.Edited</td>
                <td>@x.LentTo</td>
                <td>@x.CopiedToPlex</td>
                <td>@x.Notes</td>

                <!--buttons for actions you can take with the records-->
                <td><a class="btn btn-info" asp-controller="SecondPage" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a></td>
                <td><a class="btn btn-danger" asp-controller="SecondPage" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a></td>
            </tr>
            </tbody>
        }
    </table>
</div>
</body>
</html>