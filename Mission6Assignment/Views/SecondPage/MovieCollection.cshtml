@{
    @model Movie
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>Collection</title>
</head>
<body>
<div class="text-center">
    <h1>Film Information</h1>
    <!--link to fill out information for adding a movie-->
    <form method="post">
        <!--all until Edited is required-->
        <label asp-for="Category">Category:</label>
        <input asp-for="Category" required/>
        <br><br> <!--add space after each input-->
        <label asp-for="Title">Title</label>
        <input asp-for="Title" required/>
        <br><br>
        <label asp-for="Year">Year</label>
        <input asp-for="Year" required/>
        <br><br>
        <label asp-for="Director">Director</label>
        <input asp-for="Director" required/>
        <br><br>
        <!--drop down for ratings-->
        <label asp-for="Rating">Rating:</label>
        <select asp-for="Rating" required>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
        <br><br>
        <!--everything under here is not required to create a new database-->
        <!--radio buttons for rating-->
        <label asp-for="Edited">Edited:</label>
        <input asp-for="Edited" type="radio" value="Yes">Yes
        <input asp-for="Edited" type="radio" value="No">No
        <br><br>
        <label asp-for="LentTo">Lent to:</label>
        <input asp-for="LentTo"/>
        <br><br>
        <label asp-for="Notes">Notes</label>
        <input asp-for="Notes" maxlength="25"> <!--limit to only 25 characters-->
        <br>
        <br>
        <!--button to submit the form-->
        <button type="submit">Submit Film</button>
    </form>
</div>
</body>
</html>