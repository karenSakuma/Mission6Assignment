@{
    @model Movies
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>Collection</title>
</head>
<body>
<div class="text-center">
    <h1>Film Information</h1>
    <!--link to fill out information for adding a movie-->
    <form method="post">
         <!--keep hidden so that users won't see it when filling out info - but still needed to enter database-->
        <input type="hidden" asp-for="MovieId"/>
        
        <label asp-for="Category">Category</label>
        <select asp-for="CategoryId">
            <!--view bag to get all the category names-->
            <option value="">Select a Category</option>
            @foreach (Categories c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
        <br><br>
        <label asp-for="Title">Title</label>
        <input asp-for="Title"/>
        <br><br>
        <label asp-for="Year">Year</label>
        <input asp-for="Year"/>
        <br><br>
        <label asp-for="Director">Director</label>
        <input asp-for="Director"/>
        <br><br>
        <!--drop down for ratings-->
        <label asp-for="Rating">Rating</label>
        <select asp-for="Rating">
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="TV-PG">TV-PG</option>
            <option value="PG-13">PG-13</option>
            <option value="TV-14">TV-14</option>
            <option value="TV-Y7">TV-Y7</option>
            <option value="NR">NR</option>
            <option value="R">R</option>
            <option value="UR">UR</option>
        </select>
        <br><br>
        <!--radio buttons for rating-->
        <label asp-for="Edited">Edited</label>
        <input asp-for="Edited" type="radio" value="True">Yes
        <input asp-for="Edited" type="radio" value="False">No
        <br><br>
        <label asp-for="LentTo">Lent To</label>
        <input asp-for="LentTo"/>
        <br><br>
        <!--radio buttons for copied to plex-->
        <label asp-for="CopiedToPlex">Copied To Plex</label>
        <input asp-for="CopiedToPlex" type="radio" value="True">Yes
        <input asp-for="CopiedToPlex" type="radio" value="False">No
        <br><br>
        <label asp-for="Notes">Notes</label>
        <input asp-for="Notes">
        <br>
        <br>
        
        <!--button to submit the form-->
        <button type="submit">Submit Film</button>
        
        <!--used for validating-->
        <div asp-validation-summary="All"></div>
    </form>
</div>
</body>
</html>